# LM Studio (API OpenAI-compatible). Copia a .env y ajusta.
LLM_API_BASE_URL=http://127.0.0.1:1234/v1
LLM_MODEL=nombre-del-modelo-en-lm-studio

# Opcional
# LLM_API_KEY=
# LLM_HTTP_TIMEOUT=300
# LLM_MAX_TOKENS=2048

# Perfil opcional para API potente compatible con OpenAI.
# Por defecto el sistema sigue usando LM Studio local.
# LLM_PROFILE=deepseek
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_API_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-chat
#
# Futuro DeepSeek V4 oficial:
# usa --llm-profile deepseek_v4 o LLM_PROFILE=deepseek_v4 y ajusta el id real si cambia.
# DEEPSEEK_MODEL=deepseek-v4

# Prueba de integración real (pytest): define LLM_INTEGRATION_TEST=1
# LLM_INTEGRATION_TEST=1
