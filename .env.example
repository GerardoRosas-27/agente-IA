# Copia este archivo a `.env` y ajusta los valores.
# LM Studio: pestaña "Server" → la URL base suele ser http://<host>:<puerto>/v1
# (ej. misma máquina: 127.0.0.1:1234; otra en la red: 192.168.0.13:1234).

LLM_API_BASE_URL=http://192.168.0.13:1234/v1
LLM_MODEL=xiaomi-mimo-vl-miloco-7b

# Opcional: LM Studio acepta -1 en max_tokens = sin tope; alinea con /v1/chat/completions
# en LM Studio. Si no pones nada, el cliente usa 512 por petición.
# LLM_MAX_TOKENS=-1

# Opcional: LM Studio a veces acepta cualquier cadena; déjalo vacío si no lo pides.
# LLM_API_KEY=

# Opcional: tiempo máximo de espera por respuesta (segundos).
# LLM_HTTP_TIMEOUT=300

# Agente Internet: activo por defecto. Si no hay conexión o resultados, pasa turno.
INTERNET_AGENT_ENABLED=1
# INTERNET_AGENT_TIMEOUT=4
# INTERNET_AGENT_MAX_RESULTS=4

# Agente PruebaPython: activo por defecto. Solo ejecuta scripts pequeños si el LLM
# decide que la comprobación aporta evidencia real.
PYTHON_TEST_AGENT_ENABLED=1
# PYTHON_TEST_AGENT_TIMEOUT=5
# PYTHON_TEST_AGENT_MAX_CHARS=2500
# PYTHON_TEST_AGENT_SKIP_NON_CODE=1

# Agente PruebaNode: activo por defecto. Ejecuta scripts JavaScript pequeños con
# Node.js cuando Python no aporta evidencia suficiente o el objetivo es JS/Node.
NODE_TEST_AGENT_ENABLED=1
# NODE_TEST_AGENT_TIMEOUT=5
# NODE_TEST_AGENT_MAX_CHARS=3000
# NODE_TEST_AGENT_SKIP_NON_CODE=1

# Agente Terminal: desactivado por defecto por seguridad. Si lo activas, solo
# ejecuta comandos de lectura/verificacion permitidos por terminal_tool.py.
TERMINAL_AGENT_ENABLED=0
# TERMINAL_AGENT_TIMEOUT=10
# TERMINAL_AGENT_MAX_OUTPUT_CHARS=4000

# Politica de comandos del agente Terminal.
# Seguros y moderados activos por defecto; peligrosos desactivados.
TERMINAL_AGENT_ENABLE_SAFE_COMMANDS=1
TERMINAL_AGENT_SAFE_COMMANDS=python,py,pytest,git,rg,dir,ls,where
TERMINAL_AGENT_ENABLE_MODERATE_COMMANDS=1
TERMINAL_AGENT_MODERATE_COMMANDS=pip,node,npm
TERMINAL_AGENT_ENABLE_DANGEROUS_COMMANDS=0
TERMINAL_AGENT_DANGEROUS_COMMANDS=rm,rmdir,del,erase,remove-item,rd,format,shutdown,reboot,restart-computer,stop-computer,setx,reg,schtasks,sc

# Gestor de herramientas: activo por defecto. Recupera scripts/conectores/procedimientos
# que ya funcionaron y consolida nuevos reutilizables cuando el Revisor certifica.
TOOL_LIBRARY_AGENT_ENABLED=1
# TOOL_LIBRARY_MAX_RESULTS=4

# Plataforma agentica controlable: registry + runtime auditable.
# Riesgos: low, moderate, high, dangerous. Por defecto no auto-ejecuta high.
AGENT_AUTONOMOUS_MODE=0
TOOL_REGISTRY_MAX_AUTO_RISK=moderate
# TOOL_REGISTRY_ALLOWED_TOOLS=internet.search,probe.python,probe.node,tool_library.context,tool_library.upsert
# TOOL_REGISTRY_DENIED_TOOLS=terminal.run

# Skills/plugins declarativos en skills/<nombre>/manifest.json.
SKILL_MANAGER_ENABLED=1
# SKILL_MANAGER_MAX_RESULTS=5
# Permite que el ciclo ejecute skills instalados que declaren executor.
SKILL_EXECUTION_AGENT_ENABLED=1
# Cada skill instalado se presenta como agente modular AgenteSkill:<nombre>.
# En el manifest puedes ajustar agent_enabled y agent_role.

# Memoria persistente tipo Hermes: MEMORY.md, USER.md y archivo buscable de sesiones.
PERSISTENT_MEMORY_ENABLED=1

# Region neuronal especializada para aprender preferencias de herramientas/skills.
TOOL_PREFERENCE_NET_ENABLED=1
# TOOL_PREFERENCE_RANK_LIMIT=8

# Regiones neuronales especializadas: GoalCritic, PlannerPolicy,
# SkillComposer, SafetyRisk y AttentionRouter.
SPECIALIZED_REGIONS_ENABLED=1

# Si un agente auxiliar falla, el ciclo sigue y ese agente pasa turno.
# AUXILIARY_AGENTS_FAIL_OPEN=1
